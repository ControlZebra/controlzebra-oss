<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="control-zebra"
        Arguments=""
        InstallLocation="C:\Program Files\ControlZebra\ControlZebra">
    </Installer>
    <PackageInformation
        PackageName="ControlZebra"
        PackageDisplayName="ControlZebra"
        PublisherName="CN=ControlZebra"
        PublisherDisplayName="ControlZebra"
        Version="0.1.0.0"
        PackageDescription="A simplified Git client for industrial automation">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.controlzebra.controlzebra"
                Description="A simplified Git client for industrial automation"
                DisplayName="ControlZebra"
                ExecutableName="control-zebra"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>ControlZebra</DisplayName>
            <PublisherDisplayName>ControlZebra</PublisherDisplayName>
            <Description>A simplified Git client for industrial automation</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="control-zebra.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
