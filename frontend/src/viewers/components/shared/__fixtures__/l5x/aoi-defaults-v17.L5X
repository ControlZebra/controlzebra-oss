<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="17.00" TargetName="DefaultsController" TargetType="Controller" ContainsContext="false">
  <Controller Use="Target" Name="DefaultsController">
    <AddOnInstructionDefinitions>
      <AddOnInstructionDefinition Name="SampleDefaults" Class="Standard" Revision="1.0">
        <Parameters>
          <Parameter Name="Input" DataType="DINT" Usage="Input"><DefaultData Format="L5K"><![CDATA[5]]></DefaultData></Parameter>
        </Parameters>
        <LocalTags>
          <LocalTag Name="CurrentTS" DataType="DINT" Dimensions="2" Radix="Decimal">
            <DefaultData>00 00 00 00 00 00 00 00</DefaultData>
            <DefaultData Format="Decorated"><Array DataType="DINT" Dimensions="2" Radix="Decimal"><Element Index="[0]" Value="0" /><Element Index="[1]" Value="0" /></Array></DefaultData>
          </LocalTag>
          <LocalTag Name="DEDT_01" DataType="DEADTIME">
            <DefaultData>01 00 00 00 00 00 00 00</DefaultData>
            <DefaultData Format="Decorated"><Structure DataType="DEADTIME"><DataValueMember Name="EnableIn" DataType="BOOL" Value="1" /><DataValueMember Name="In" DataType="REAL" Radix="Float" Value="0.0" /><DataValueMember Name="InFault" DataType="BOOL" Value="0" /></Structure></DefaultData>
          </LocalTag>
          <LocalTag Name="InstTracker" DataType="MOTION_INSTRUCTION" Dimensions="10">
            <DefaultData>00 00 00 00</DefaultData>
            <DefaultData Format="Decorated"><Array DataType="MOTION_INSTRUCTION" Dimensions="10"><Element Index="[0]"><Structure DataType="MOTION_INSTRUCTION"><DataValueMember Name="FLAGS" DataType="DINT" Radix="Decimal" Value="0" /><DataValueMember Name="EN" DataType="BOOL" Value="0" /></Structure></Element></Array></DefaultData>
          </LocalTag>
        </LocalTags>
      </AddOnInstructionDefinition>
    </AddOnInstructionDefinitions>
  </Controller>
</RSLogix5000Content>
