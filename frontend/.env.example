# Optional account integration. Copy to .env.local and use your own project.
# Publishable keys are client-facing; secure Supabase data with RLS policies.
# Never place service-role keys, private keys, or other server secrets in VITE_*.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=YOUR_PUBLISHABLE_KEY_HERE

# Optional analytics. Leave unset unless you want to use your own PostHog project.
# VITE_PUBLIC_POSTHOG_KEY=YOUR_POSTHOG_PROJECT_TOKEN
# VITE_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
