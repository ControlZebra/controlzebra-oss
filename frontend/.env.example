# Supabase Configuration
# Copy this file to .env.local and fill in your project values.
# The publishable key is safe to embed in a desktop client — it only grants
# access that Row Level Security (RLS) allows.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=YOUR_PUBLISHABLE_KEY_HERE
